[resource]
script = ExtResource("1_vhsrq")
body = "Dear my Elohim,

I command that Angels of Yahuah protect me and my family no matter where we are going, and no matter what we are doing today!

Yahuah,

Cancel all evil spirits’ activities on us. Cancel their evil plans!

Thank you for your help.

I pray in the mighty name of Yeshua.

I love you.

Hallelujah!"
title = "Prayer for Protection"
author = "Urie Wilson, LovelyGodOfficial"
date = "10-25-2026"
desc = "A prayer for Divine Protection"
