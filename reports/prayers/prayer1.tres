[resource]
script = ExtResource("1_m3k3v")
body = "Dear my Elohim,

Please forgive my sins and my mistakes, and purify my soul and spirit.

Yahuah,

Have mercy on me and deliver my blessings to me.

Thank you for your mercy and forgiveness.

I pray in the mighty name of Yeshua.

i love you.
 
Hallelujah!"
title = "Prayer to Restore Blessings"
author = "Urie Wilson, LovelyGodOfficial"
date = "10-25-2026"
desc = "A prayer to restore blessings"
