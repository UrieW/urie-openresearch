[resource]
script = ExtResource("1_ov5iv")
body = "Dear Most High,

Please send my prayers to the dead person or group that I loathe as a 
gift to send to them on their journey.

I pray in mighty Yeshua's Name,

I love you.

Hallelujah!"
title = "Prayer to Send the Dead Back Home"
author = "Urie Wilson"
date = "10-25-2026"
desc = "A prayer to send the dead back home"
