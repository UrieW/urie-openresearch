[resource]
script = ExtResource("1_ykfab")
body = "Dear my Elohim,

Please use your holy water to cleanse my body, and purify my spirit, my
soul and my body.

Please help me to get it cleansed and purified by your holy water.

I pray in the mighty name of Yeshua.

I love you.

Hallelujah!"
title = "Prayer for Shower Cleansing"
author = "Urie Wilson, LovelyGodOfficial"
date = "10-25-2026"
desc = "A prayer for Divine Purification in the shower"
