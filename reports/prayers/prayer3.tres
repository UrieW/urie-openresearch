[resource]
script = ExtResource("1_itowp")
body = "We give thanks to Yeshua Almighty, for the food that He brought us through His Power, and without It, we would cease to exist, and we will never seize the victory

I pray in mighty Yeshua's Name,

I love you.

Hallelujah!
"
title = "Food Blessing Prayer"
author = "Urie Wilson"
date = "10-25-2026"
desc = "A prayer over your food for Divine Deliverance"
